DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56439/postgres
DEMO_PASSWORD=popin-demo-change-me
POPIN_ENVIRONMENT=local
# Set only to the internal staff ID explicitly authorised for product operations.
# POPIN_OPERATOR_STAFF_ID=
# Stripe test mode only. Never put live keys here.
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# Shop subscription webhook signing secret and plan catalogue (test mode only).
# STRIPE_TEST_BILLING_WEBHOOK_SECRET=
# POPIN_BILLING_PLANS=[{"key":"shop","name":"Shop plan","priceId":"price_replace_with_test_id","amountCents":5900,"includedSms":500,"interval":"month"}]
# STRIPE_TEST_BILLING_PORTAL_CONFIGURATION=
# POPIN_PUBLIC_ORIGIN=http://127.0.0.1:3001
# Optional Google Calendar test-project credentials. Configure the matching
# OAuth redirect URI: <POPIN_PUBLIC_ORIGIN>/api/integrations/google/callback
# Generate a unique 32-byte key, base64-encoded, and keep it private and stable.
# POPIN_GOOGLE_CLIENT_ID=
# POPIN_GOOGLE_CLIENT_SECRET=
# POPIN_CALENDAR_TOKEN_KEY=

# Approved-owner registration is off by default. Never enable for a public launch implicitly.
# Requires HTTPS POPIN_PUBLIC_ORIGIN, RESEND_API_KEY and POPIN_EMAIL_FROM.
# Review the existing public beta-interest queue before adding an email.
# POPIN_OWNER_SIGNUP_ENABLED=false
# POPIN_OWNER_SIGNUP_ALLOWED_EMAILS=
# Signup creates an unverified private draft only. POPIN_PILOT_SHOP_ID and the
# existing verified-owner/delivery/restore gates separately control shop launch.

# Optional verified-owner password recovery, also off by default.
# Requires HTTPS POPIN_PUBLIC_ORIGIN and the same transactional email sender.
# POPIN_OWNER_RECOVERY_ENABLED=false
